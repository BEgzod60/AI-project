# VPS'da: cp .env.prod.example .env  va qiymatlarni to'ldiring

# Django
DJANGO_SECRET_KEY=uzun-tasodifiy-kalit-qoying
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=test.iymanim.uz
DJANGO_CSRF_TRUSTED_ORIGINS=https://test.iymanim.uz
DJANGO_CORS_ALLOWED_ORIGINS=https://test.iymanim.uz

# PostgreSQL (docker ichidagi db konteyneri)
POSTGRES_DB=iymon
POSTGRES_USER=iymon
POSTGRES_PASSWORD=kuchli-parol-qoying
# Tashqi baza (masalan Neon) ishlatilsa — shuni oching, db konteyneri e'tiborsiz qoladi:
# DATABASE_URL=postgres://user:parol@host/iymon?sslmode=require

# AI yordamchi (Groq — bepul). NEON_AI_GATEWAY_* kerak emas: Neon AI Gateway pullik rejani talab qiladi.
# Kalitni https://console.groq.com dan oling va faqat serverdagi .env ga yozing.
AI_ENABLED=true
AI_BASE_URL=https://api.groq.com/openai/v1
AI_API_KEY=
AI_MODEL=openai/gpt-oss-120b
AI_VISION_MODEL=qwen/qwen3.8-27b

# Ixtiyoriy
QF_CLIENT_ID=
QF_CLIENT_SECRET=
GOOGLE_MAPS_API_KEY=
