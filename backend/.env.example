# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,backend,maningiymonim.uz,www.maningiymonim.uz
DJANGO_CSRF_TRUSTED_ORIGINS=https://maningiymonim.uz,https://www.maningiymonim.uz
DJANGO_CORS_ALLOWED_ORIGINS=https://maningiymonim.uz,https://www.maningiymonim.uz
# DNS va HTTPS to'liq tekshirilmaguncha 0 qoldiring.
DJANGO_SECURE_HSTS_SECONDS=0

# Baza. Bo'sh bo'lsa SQLite (db.sqlite3) ishlatiladi.
# DATABASE_URL=postgres://iymon:parol@localhost:5432/iymon
# Port 8000 band bo'lsa: python manage.py runserver 127.0.0.1:8001

# Aloqa formasi -> Telegram bot. Token @BotFather'dan; chat ID: botga /start yuborib,
# `python manage.py telegram_chat_id --save`. Bo'sh bo'lsa forma «sozlanmagan» deb javob beradi.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Masjidlar reytingi (Google Maps, ixtiyoriy). Places API (New) yoqilgan, cheklangan (faqat Places API) kalit.
# Bo'sh bo'lsa reyting ko'rsatilmaydi. Narx: Nearby Search Enterprise SKU (bepul limitdan keyin pullik).
GOOGLE_MAPS_API_KEY=

# Private Cloudflare R2 audio storage. Keep the bucket private during review.
# Enable only after the migration report confirms every required file.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Reserved for a future rights-approved public release; ignored during review.
R2_PUBLIC_BASE_URL=
R2_AUDIO_ENABLED=false

# AI yordamchi (ixtiyoriy)
# NEON_AI_GATEWAY_BASE_URL=
# NEON_AI_GATEWAY_TOKEN=
# AI_API_KEY=
# AI_BASE_URL=
# AI_MODEL=

